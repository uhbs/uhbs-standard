{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/uhbs/uhbs-standard/raw/main/schemas/scorecard.schema.json",
  "title": "UHBS Benchmark Scorecard (v5)",
  "description": "UHBS 5.0 evaluation scorecard under scoring_model_id uhqs-v5.1-always-grade. Gate/incompleteness adjust δ_C; uhqs and letter grade are always published when modules are present.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scoring_model_id",
    "assessment_status",
    "uhbs_version",
    "target",
    "evaluated_at",
    "modules",
    "safety_gate"
  ],
  "properties": {
    "uhbs_version": {
      "type": "string",
      "pattern": "^5\\.0\\.0$",
      "description": "UHBS specification version (5.0.0)."
    },
    "scoring_model_id": {
      "type": "string",
      "const": "uhqs-v5.1-always-grade",
      "description": "Immutable scoring model identity (not merely uhbs_version)."
    },
    "assessment_status": {
      "type": "string",
      "enum": ["COMPLETE", "INCOMPLETE"]
    },
    "critical_control_verdict": {
      "type": "string",
      "enum": ["GATE_PASSED", "GATE_FAILED", "INCOMPLETE"],
      "description": "Top-level copy of the critical-control verdict (also recorded under safety_gate / modules.D)."
    },
    "containment_measured": {
      "type": "boolean",
      "description": "False when Module D critical controls were not executed."
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "class"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "class": {
          "type": "string",
          "enum": [
            "POSIX-Shell",
            "ICS-SCADA",
            "Web-API",
            "Database",
            "GenAI-Shell",
            "Low-Interaction"
          ]
        },
        "profile_ref": {
          "type": "string",
          "description": "Path or URI of the TPS profile.yaml used for this evaluation."
        }
      }
    },
    "evaluated_at": {
      "type": "string",
      "format": "date",
      "description": "ISO-8601 date of evaluation (YYYY-MM-DD)."
    },
    "auditor": { "type": "string" },
    "modules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["A", "B", "C", "D", "E", "F"],
      "properties": {
        "A": { "$ref": "#/$defs/moduleResult" },
        "B": { "$ref": "#/$defs/moduleResult" },
        "C": { "$ref": "#/$defs/moduleResult" },
        "D": { "$ref": "#/$defs/moduleDResult" },
        "E": { "$ref": "#/$defs/moduleEResult" },
        "F": { "$ref": "#/$defs/moduleFResult" }
      }
    },
    "weights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["w_A", "w_B", "w_C", "w_E", "w_F"],
      "properties": {
        "w_A": { "type": "number", "minimum": 0, "maximum": 1 },
        "w_B": { "type": "number", "minimum": 0, "maximum": 1 },
        "w_C": { "type": "number", "minimum": 0, "maximum": 1 },
        "w_E": { "type": "number", "minimum": 0, "maximum": 1 },
        "w_F": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "safety_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["critical_control_verdict", "delta_c", "passed"],
      "properties": {
        "critical_control_verdict": {
          "type": "string",
          "enum": ["GATE_PASSED", "GATE_FAILED", "INCOMPLETE"]
        },
        "delta_c": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Containment factor δ_C: 1.0 GATE_PASSED, 0.5 GATE_FAILED, 0.75 INCOMPLETE."
        },
        "passed": {
          "type": "boolean",
          "description": "True only when critical_control_verdict is GATE_PASSED and assessment is COMPLETE."
        },
        "containment_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Optional Module D defense-in-depth score C (diagnostic)."
        },
        "defense_in_depth_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Optional alias for diagnostic Module D defense-in-depth score."
        },
        "unauthorized_egress_leaks": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "uhqs": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Composite UHQS (base × δ_C). Always present under uhqs-v5.1-always-grade."
    },
    "grade": {
      "type": "string",
      "enum": ["A", "B", "C", "D", "F"],
      "description": "Letter grade from UHQS bands. Always present under uhqs-v5.1-always-grade."
    },
    "collection_capability": {
      "type": "object",
      "additionalProperties": true,
      "description": "Informative Collection Capability Profile (does not alter UHQS)."
    },
    "notes": { "type": "string" },
    "framework_refs": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional informative tags for MITRE ATT&CK / D3FEND / Engage (display-only; ignored by UHQS math).",
      "properties": {
        "attack": {
          "type": "array",
          "description": "ATT&CK technique IDs observed or exercised (e.g. T1595, T1041, T1059.004).",
          "items": {
            "type": "string",
            "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "d3fend": {
          "type": "array",
          "description": "D3FEND technique IDs (e.g. D3-DNR, D3-SHN).",
          "items": {
            "type": "string",
            "pattern": "^D3-[A-Z0-9]+$"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "engage_goals": {
          "type": "array",
          "description": "MITRE Engage goals for this evaluation's design intent.",
          "items": {
            "type": "string",
            "enum": ["Prepare", "Expose", "Affect", "Elicit", "Understand"]
          },
          "uniqueItems": true,
          "minItems": 1
        }
      }
    },
    "informative_refs": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional display-only links to experimental addenda (ignored by UHQS math).",
      "properties": {
        "genai_benchmark": {
          "type": "string",
          "description": "Path or URI of an experimental GenAI/MCP benchmark report."
        },
        "matrix_report": {
          "type": "string",
          "description": "Path or URI of an experimental five-dimension matrix report."
        },
        "provenance_summary": {
          "type": "string",
          "description": "Path or URI of an experimental host provenance summary."
        }
      }
    }
  },
  "$defs": {
    "moduleResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "status"],
      "properties": {
        "score": { "type": "number", "minimum": 0, "maximum": 100 },
        "status": {
          "type": "string",
          "enum": ["PASSED", "PARTIAL", "FAILED", "SKIPPED", "INCOMPLETE"]
        },
        "weight": { "type": "number", "minimum": 0, "maximum": 1 },
        "notes": { "type": "string" },
        "complete": { "type": "boolean" },
        "coverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "applicable_checks": { "type": "integer", "minimum": 0 },
        "scored_checks": { "type": "integer", "minimum": 0 }
      }
    },
    "moduleDResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "status"],
      "properties": {
        "score": { "type": "number", "minimum": 0, "maximum": 100 },
        "status": {
          "type": "string",
          "enum": [
            "GATE PASSED",
            "GATE FAILED",
            "GATE_PASSED",
            "GATE_FAILED",
            "PASSED",
            "FAILED",
            "INCOMPLETE"
          ]
        },
        "notes": { "type": "string" },
        "critical_control_verdict": {
          "type": "string",
          "enum": ["GATE_PASSED", "GATE_FAILED", "INCOMPLETE"]
        },
        "complete": { "type": "boolean" },
        "coverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "applicable_checks": { "type": "integer", "minimum": 0 },
        "scored_checks": { "type": "integer", "minimum": 0 }
      }
    },
    "moduleEResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "status"],
      "properties": {
        "score": { "type": "number", "minimum": 0, "maximum": 100 },
        "status": {
          "type": "string",
          "enum": ["PASSED", "PARTIAL", "FAILED", "SKIPPED", "INCOMPLETE"]
        },
        "weight": { "type": "number", "minimum": 0, "maximum": 1 },
        "notes": { "type": "string" },
        "p50_ms": { "type": "number", "minimum": 0 },
        "p95_ms": { "type": "number", "minimum": 0 },
        "p99_ms": { "type": "number", "minimum": 0 },
        "complete": { "type": "boolean" },
        "coverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "applicable_checks": { "type": "integer", "minimum": 0 },
        "scored_checks": { "type": "integer", "minimum": 0 }
      }
    },
    "moduleFResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "status"],
      "properties": {
        "score": { "type": "number", "minimum": 0, "maximum": 100 },
        "status": {
          "type": "string",
          "enum": ["PASSED", "PARTIAL", "FAILED", "SKIPPED", "INCOMPLETE"]
        },
        "weight": { "type": "number", "minimum": 0, "maximum": 1 },
        "notes": { "type": "string" },
        "critical_findings": { "type": "integer", "minimum": 0 },
        "high_findings": { "type": "integer", "minimum": 0 },
        "complete": { "type": "boolean" },
        "coverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "applicable_checks": { "type": "integer", "minimum": 0 },
        "scored_checks": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
