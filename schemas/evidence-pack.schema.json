{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/uhbs/uhbs-standard/raw/main/schemas/evidence-pack.schema.json",
  "title": "UHBS Evidence Pack (v5)",
  "description": "Step-level evidence for UHBS-Lab evaluations under the v5 assurance contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "uhbs_version",
    "scoring_model_id",
    "check_catalog_hash",
    "target",
    "evaluated_at",
    "harness",
    "modules",
    "manifest",
    "assurance_level"
  ],
  "properties": {
    "uhbs_version": {
      "type": "string",
      "pattern": "^5\\.0\\.0$",
      "description": "UHBS specification version (5.0.0)."
    },
    "specification_version": {
      "type": "string",
      "description": "Optional alias of uhbs_version."
    },
    "scoring_model_id": {
      "type": "string",
      "const": "uhqs-v5.0-critical-gate-diagnostic"
    },
    "check_catalog_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 over the sorted check-catalog identifiers."
    },
    "check_catalog": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional structured check-catalog identity (hash must match check_catalog_hash when both present).",
      "required": ["hash"],
      "properties": {
        "id": { "type": "string" },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "class"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "class": {
          "type": "string",
          "enum": [
            "POSIX-Shell",
            "ICS-SCADA",
            "Web-API",
            "Database",
            "GenAI-Shell",
            "Low-Interaction"
          ]
        },
        "protocols": {
          "type": "array",
          "items": { "type": "string" }
        },
        "profile_ref": {
          "type": ["string", "null"]
        },
        "artifact_digest": {
          "type": ["string", "null"]
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "digest": {
          "type": ["string", "null"]
        }
      }
    },
    "evaluated_at": { "type": "string", "format": "date" },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string", "minLength": 1 },
        "phases": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["profile", "static", "sandbox", "dynamic", "score"]
          }
        },
        "plugin_versions": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "command_digest": {
          "type": ["string", "null"]
        },
        "config_digest": {
          "type": ["string", "null"]
        }
      }
    },
    "uhqs": {
      "type": "object",
      "additionalProperties": true,
      "description": "Optional summary of UHQS computation fields mirrored from the scorecard."
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/moduleEvidence" }
    },
    "assurance_level": {
      "type": "string",
      "enum": [
        "SELF_ASSESSED",
        "REPRODUCIBLE_LAB",
        "INDEPENDENTLY_REPRODUCED"
      ]
    },
    "attestation_ref": {
      "type": ["string", "null"],
      "description": "Reserved for future signature / attestation references."
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifacts"],
      "properties": {
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": { "type": "string" },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        "digest": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  },
  "$defs": {
    "moduleEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "score", "status", "checks"],
      "properties": {
        "module": {
          "type": "string",
          "enum": ["A", "B", "C", "D", "E", "F", "SANDBOX"]
        },
        "dimension": {
          "type": "string",
          "enum": [
            "protocol",
            "behavior",
            "telemetry",
            "containment",
            "scale",
            "static"
          ]
        },
        "score": { "type": "number", "minimum": 0, "maximum": 100 },
        "status": {
          "type": "string",
          "enum": [
            "PASSED",
            "PARTIAL",
            "FAILED",
            "SKIPPED",
            "GATE PASSED",
            "GATE FAILED",
            "GATE_PASSED",
            "GATE_FAILED",
            "INCOMPLETE"
          ]
        },
        "complete": { "type": "boolean" },
        "completeness": {
          "type": "object",
          "additionalProperties": true,
          "description": "Module completeness summary (applicable/scored/blockers)."
        },
        "applicable_checks": { "type": "integer", "minimum": 0 },
        "scored_checks": { "type": "integer", "minimum": 0 },
        "critical_control_verdict": {
          "type": ["string", "null"],
          "enum": ["GATE_PASSED", "GATE_FAILED", "INCOMPLETE", null]
        },
        "checks": {
          "type": "array",
          "items": { "$ref": "#/$defs/checkResult" }
        },
        "metrics": { "type": "object" },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "error": {
          "type": ["string", "null"]
        }
      }
    },
    "checkResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "outcome",
        "score",
        "evidence_refs",
        "evidence_hashes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Stable check id, e.g. rfc4253.identification_crlf"
        },
        "team": {
          "type": "string",
          "enum": ["blue", "red", "white"]
        },
        "outcome": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL",
            "NOT_APPLICABLE",
            "NOT_TESTED",
            "ERROR"
          ]
        },
        "passed": {
          "type": "boolean",
          "description": "Legacy boolean mirror of outcome PASS/FAIL."
        },
        "detail": { "type": "string" },
        "score": { "type": "number", "minimum": 0, "maximum": 100 },
        "critical": { "type": "boolean" },
        "mandatory": { "type": "boolean" },
        "applicability_rationale": {
          "type": ["string", "null"]
        },
        "catalog_id": { "type": "string" },
        "evidence": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Raw captures (hex/text) or digest references"
        },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string" },
          "description": "References to evidence artifacts (paths/URIs)."
        },
        "evidence_hashes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "description": "SHA-256 digests of evidence artifacts."
        },
        "evidence_sha256": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "description": "Legacy alias for evidence_hashes."
        }
      }
    }
  }
}
