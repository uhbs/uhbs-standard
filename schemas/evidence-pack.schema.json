{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/uhbs/uhbs-standard/raw/main/schemas/evidence-pack.schema.json",
  "title": "UHBS Evidence Pack",
  "description": "Step-level evidence for UHBS-Lab evaluations. Aligns with reference harness ModuleResult.checks[].",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "uhbs_version",
    "target",
    "evaluated_at",
    "modules",
    "manifest"
  ],
  "properties": {
    "uhbs_version": { "type": "string", "const": "4.5.2" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "class"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "class": {
          "type": "string",
          "enum": [
            "POSIX-Shell",
            "ICS-SCADA",
            "Web-API",
            "Database",
            "GenAI-Shell",
            "Low-Interaction"
          ]
        },
        "protocols": {
          "type": "array",
          "items": { "type": "string" }
        },
        "profile_ref": { "type": "string" }
      }
    },
    "evaluated_at": { "type": "string", "format": "date" },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "phases": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["profile", "static", "sandbox", "dynamic", "score"]
          }
        }
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/moduleEvidence" }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifacts"],
      "properties": {
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": { "type": "string" },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "moduleEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "score", "status", "checks"],
      "properties": {
        "module": {
          "type": "string",
          "enum": ["A", "B", "C", "D", "E", "F", "SANDBOX"]
        },
        "dimension": {
          "type": "string",
          "enum": ["protocol", "behavior", "telemetry", "containment", "scale", "static"]
        },
        "score": { "type": "number", "minimum": 0, "maximum": 100 },
        "status": {
          "type": "string",
          "enum": ["PASSED", "PARTIAL", "FAILED", "SKIPPED", "GATE PASSED", "GATE FAILED"]
        },
        "checks": {
          "type": "array",
          "items": { "$ref": "#/$defs/checkResult" }
        },
        "metrics": { "type": "object" },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "checkResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "passed"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Stable check id, e.g. rfc4253.identification_crlf"
        },
        "team": {
          "type": "string",
          "enum": ["blue", "red", "white"]
        },
        "passed": { "type": "boolean" },
        "detail": { "type": "string" },
        "score": { "type": "number", "minimum": 0, "maximum": 100 },
        "evidence": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Raw captures (hex/text) or digest references"
        },
        "evidence_sha256": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
